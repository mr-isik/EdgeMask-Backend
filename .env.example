# ═══════════════════════════════════════════════════════════════
#  EdgeMask Backend — Environment Variables
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────
PORT=3000
APP_ENV=development                         # development | production

# ─── Supabase ────────────────────────────────────────────────
# Project URL (Dashboard → Settings → API → URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for frontend/client-side)
SUPABASE_ANON_KEY=eyJ...

# Service role key (NEVER expose in client code)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT secret for verifying Supabase tokens (Dashboard → Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Database (Supabase PostgreSQL via Pooler) ───────────────
# Connection format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:6543/postgres
# Get from: Dashboard → Settings → Database → Connection String → URI (Transaction Pooler)
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# ─── Security ────────────────────────────────────────────────
# HMAC secret for hashing EdgeMask API keys (edgemask_live_...)
API_KEY_SECRET=change-me-to-a-random-secret

# 32-byte key for AES-256-GCM encryption of customer provider keys
MASTER_KEY=01234567890123456789012345678901

# ─── LLM Provider Base URLs ─────────────────────────────────
# Customer API keys come from the database (BYOK model), not env
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ─── Semantic Cache (Redis + pgvector) ───────────────────────
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_SIMILARITY_MIN=0.92
SEMANTIC_CACHE_EMBEDDING_MODEL=text-embedding-3-small

# ─── Dodo Payments (Usage-Based Billing) ───────────────────────
# Enable only after creating a usage meter in Dodo.
DODO_PAYMENTS_ENABLED=false
DODO_PAYMENTS_API_KEY=dp_test_xxx
# test: https://test.dodopayments.com | live: https://live.dodopayments.com
DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com
# Must exactly match your Dodo meter event name (case-sensitive).
DODO_PAYMENTS_EVENT_NAME=api.tokens.used
# Webhook secret from Dodo Dashboard > Developer > Webhooks
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_xxx
# Allowed clock skew for webhook timestamp validation (seconds)
DODO_PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300
