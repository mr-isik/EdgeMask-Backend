# ─── Server ──────────────────────────────────────────────
PORT=3000
APP_ENV=development

# ─── PostgreSQL (Supabase) ───────────────────────────────
DATABASE_URL=postgres://postgres:secret@localhost:5432/edgemask?sslmode=disable

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# ─── Security ────────────────────────────────────────────
API_KEY_SECRET=change-me-to-a-random-secret
MASTER_KEY=01234567890123456789012345678901
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── LLM Provider Base URLs (NO API KEYS — those are per-customer in DB)
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
